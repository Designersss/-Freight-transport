{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "//#test:stack": {
      "cache": false,
      "env": [
        "STACK_SMOKE",
        "TEST_DATABASE_URL",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY"
      ]
    },
    "@freight/web#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@freight/admin#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@freight/storybook#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
