# Скопировать в .env и задать пароль локальной базы; не коммитить .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
POSTGRES_USER=freight
POSTGRES_DB=freight
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
# URL must match POSTGRES_*; URL-encode special characters in password.
DATABASE_URL=
OUTBOX_BATCH_SIZE=100
# Enable only after verifying that the photo namespace belongs to this database.
PROFILE_PHOTO_SCAN_ENABLED=false
# Private local S3; use unique generated credentials (secret >= 16 characters).
S3_ENDPOINT=http://127.0.0.1:8333
S3_PORT=8333
S3_BUCKET=freight-private
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Auth dev/test API opt-in; production activation remains blocked.
AUTH_ENABLED=false
# Web preview opt-in; enable only in local dev/test.
MOVARO_AUTH_PREVIEW=false
# Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_BASE_URL=http://127.0.0.1:4000
AUTH_WEB_ORIGIN=http://127.0.0.1:3000
AUTH_SECRET=
# Optional trusted ingress mode, separate secret: openssl rand -hex 32.
# Enable only with private backends and ingress overwriting both proxy headers.
# AUTH_PROXY_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=local
SMTP_FROM=auth@movaro.test
# Optional SMTP_USER and SMTP_PASSWORD must both be set, never for local mode.
# Production requires HTTPS origins and SMTP_SECURITY=tls or starttls.

# Telegram bot staging only; activate explicitly with compose.staging.telegram.yml.
# See infra/staging.md; keep Telegram credentials in separate service env files.
# TELEGRAM_BOT_TOKEN=
# AUTH_TELEGRAM_BOT_USERNAME= (without @; API only)
# AUTH_TELEGRAM_BOT_INTERNAL_SECRET=
# TELEGRAM_BOT_API_ORIGIN=http://127.0.0.1:4000
# AUTH_WEB_ORIGIN must be the approved HTTPS staging origin for the bot.

# Optional separate Admin auth origin and secret (generate independently).
# AUTH_ADMIN_ORIGIN=http://127.0.0.1:3001
# AUTH_ADMIN_SECRET=
