# Скопировать в .env и задать пароль локальной базы; не коммитить .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
POSTGRES_USER=freight
POSTGRES_DB=freight
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
# URL must match POSTGRES_*; URL-encode special characters in password.
DATABASE_URL=
