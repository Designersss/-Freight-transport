{
  "name": "@freight/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/health/readiness.integration.test.ts",
    "openapi:generate": "node dist/openapi/export.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-fastify": "11.2.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@freight/database": "workspace:*",
    "@nestjs/swagger": "11.4.8",
    "@fastify/static": "10.1.4",
    "@freight/config": "workspace:*",
    "fastify": "5.12.8",
    "@freight/auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
