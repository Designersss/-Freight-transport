    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-fastify": "11.2.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@freight/config": "workspace:*",
    "@types/node": "24.0.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
