{
  "name": "@freight/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/storage.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.922.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@freight/config": "workspace:*",
    "@types/node": "24.0.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
