generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Transactional outbox; processedAt denotes committed publication, not external delivery.
model OutboxEvent {
  id          String            @id @default(uuid()) @db.Uuid
  eventType   String            @map("event_type")
  aggregateId String            @map("aggregate_id")
  payload     Json
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime?         @map("processed_at") @db.Timestamptz(6)
  attempts    Int               @default(0)
  publication EventPublication?

  @@index([processedAt, createdAt], map: "outbox_events_pending_idx")
  @@map("outbox_events")
}

model EventPublication {
  eventId     String      @id @map("event_id") @db.Uuid
  publishedAt DateTime    @default(now()) @map("published_at") @db.Timestamptz(6)
  event       OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([publishedAt, eventId], map: "event_publications_published_idx")
  @@map("event_publications")
}

model UserEventStream {
  userId        String                  @id @map("user_id")
  lastSequence  BigInt                  @default(0) @map("last_sequence")
  invalidations UserEventInvalidation[]

  @@map("user_event_streams")
}

model UserEventInvalidation {
  userId   String          @map("user_id")
  sequence BigInt
  stream   UserEventStream @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, sequence])
  @@map("user_event_invalidations")
}

// Better Auth 1.7.28 core tables, managed exclusively by Prisma migrations.
model User {
  id                String       @id
  name              String
  email             String       @unique(map: "user_email_uidx")
  emailVerified     Boolean      @default(false)
  image             String?
  username          String?      @unique(map: "user_username_uidx")
  registrationDraft String?
  usernameChangedAt DateTime?    @map("username_changed_at") @db.Timestamptz(6)
  telegramLinkRevision Int      @default(0)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  accounts          Account[]
  sessions          Session[]
  profile           UserProfile?
  pendingEmailChange PendingEmailChange?

  @@map("user")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  linkSessionId         String?
  linkRevision          Int?
  telegramSessions      Session[] @relation("TelegramLoginAccount")
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId], map: "account_providerId_accountId_uidx")
  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique(map: "session_token_uidx")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  telegramAccountId String?
  telegramAccount Account? @relation("TelegramLoginAccount", fields: [telegramAccountId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "session_telegram_account_fkey")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  pendingEmailChanges PendingEmailChange[]

  @@index([userId], map: "session_userId_idx")
  @@index([telegramAccountId], map: "session_telegram_account_idx")
  @@map("session")
}

model PendingEmailChange {
  userId     String   @id @map("user_id")
  sessionId  String   @map("session_id")
  oldEmail   String   @map("old_email")
  newEmail   String   @map("new_email")
  tokenHash  String   @unique(map: "pending_email_change_token_hash_uidx") @map("token_hash")
  stage      String
  locale     String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "pending_email_change_session_idx")
  @@map("pending_email_change")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique(map: "rateLimit_key_uidx")
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

enum UserRole {
  PLATFORM_ADMIN
  COMPANY_OWNER
  DISPATCHER
  DRIVER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DEACTIVATED

  @@map("user_status")
}

// Absence of a profile means onboarding is incomplete, not an authorized role.
model UserProfile {
  userId      String     @id @map("user_id")
  firstName   String     @map("first_name")
  lastName    String     @map("last_name")
  role        UserRole
  status      UserStatus @default(ACTIVE)
  birthDate   DateTime   @map("birth_date") @db.Date
  companyName String?    @map("company_name")
  photoKey    String?    @unique(map: "user_profiles_photo_key_uidx") @map("photo_key")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_profiles")
}

// Application-level limits independent of Better Auth's per-IP buckets.
model AuthMailRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "auth_mail_rate_limits_expiry_idx")
  @@map("auth_mail_rate_limits")
}

// Staged upload reservations and retired objects awaiting private S3 cleanup.
model ProfilePhotoCleanup {
  key         String   @id
  ownerId     String?  @map("owner_id")
  availableAt DateTime @map("available_at") @db.Timestamptz(6)
  attempts    Int      @default(0)

  @@index([availableAt, key], map: "profile_photo_cleanup_available_idx")
  @@map("profile_photo_cleanup")
}

// A single durable cursor for the private profile photo inventory.
model ProfilePhotoScan {
  id                Int     @id
  revision          Int     @default(0)
  continuationToken String? @map("continuation_token")

  @@map("profile_photo_scan")
}
