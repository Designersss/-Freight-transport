{
  "name": "@freight/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test src/runtime.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
