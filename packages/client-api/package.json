{
  "name": "@freight/client-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/client.integration.test.ts"
  },
  "devDependencies": {
    "@freight/config": "workspace:*",
    "@types/node": "24.0.0",
    "orval": "8.47.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
