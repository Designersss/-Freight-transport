{
  "name": "@freight/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./proxy-ip": {
      "types": "./dist/proxy-ip.d.ts",
      "import": "./dist/proxy-ip.js"
    },
    "./telegram-bot-internal": {
      "types": "./dist/telegram-bot-internal.d.ts",
      "import": "./dist/telegram-bot-internal.js"
    },
    "./telegram-browser-http": {
      "types": "./dist/telegram-browser-http.d.ts",
      "import": "./dist/telegram-browser-http.js"
    },
    "./telegram-cleanup": {
      "types": "./dist/telegram-cleanup.d.ts",
      "import": "./dist/telegram-cleanup.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "admin:create": "node dist/admin-cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/config.test.ts src/proxy-ip.test.ts src/registration-email-token.test.ts"
  },
  "dependencies": {
    "@freight/config": "workspace:*",
    "@freight/storage": "workspace:*",
    "better-auth": "1.7.28",
    "nodemailer": "10.6.1",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/node": "24.0.0",
    "@types/pg": "8.15.6",
    "typescript": "5.9.3"
  }
}
